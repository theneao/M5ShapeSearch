# M5ShapeSearch 服务端环境变量示例
# 复制为 .env 后按需调整；.env 会被 Git 忽略。

# FastAPI 与两个 Gradio 页面
API_PORT=8000
GRADIO_SERVER_PORT=7860
SETTINGS_SERVER_PORT=7861
SHAPE_API_BASE=http://127.0.0.1:8000

# CPU 行情缓存目录
CPU_SHAPE_DATA_DIR=./data/cpu_shape_search

# 设为 0 可关闭后台定时检查；手工刷新仍可通过 API 或设置页执行。
MARKET_DATA_AUTO_REFRESH=1

# 可选日志级别
LOG_LEVEL=INFO
